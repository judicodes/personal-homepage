---
import ConnectLayout from '../layouts/ConnectLayout.astro';
import { Image } from 'astro:assets';
import photo from '../assets/judi1_square_small.jpeg';
---

<ConnectLayout title="Connect — Judith Boehlert" description="Ways to reach and follow Judith Boehlert">
  <main id="main-content" class="w-full max-w-sm mx-auto px-6 py-16">

    <!-- Header -->
    <div class="text-center mb-10">
      <Image
        src={photo}
        alt="Judith Boehlert"
        width={128}
        height={128}
        class="w-16 h-16 rounded-full object-cover mx-auto mb-4"
      />
      <h1 class="font-serif text-2xl font-bold text-ink dark:text-cream">
        Judith Boehlert
      </h1>
      <p class="text-sm text-stone-light dark:text-stone-dark mt-1">
        Software Engineer &amp; Consultant
      </p>
    </div>

    <!-- Link list -->
    <nav aria-label="Contact links" class="flex flex-col gap-3">

      <!-- Low Noise newsletter -->
      <a
        href="https://lownoiseclub.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Low Noise Newsletter (opens in new tab)"
        class="flex items-center justify-between w-full px-5 py-4 rounded-xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 text-ink dark:text-cream hover:border-cocoa/40 dark:hover:border-cocoa/40 hover:bg-cocoa/5 dark:hover:bg-cocoa/5 transition-colors duration-150 group"
      >
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-cocoa"
            aria-hidden="true"
          >
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/>
          </svg>
          <span class="text-sm font-medium">Low Noise Newsletter</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light group-hover:text-cocoa transition-colors" aria-hidden="true">
          <path d="M7 7h10v10M7 17 17 7"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/jboehlert/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Connect on LinkedIn (opens in new tab)"
        class="flex items-center justify-between w-full px-5 py-4 rounded-xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 text-ink dark:text-cream hover:border-cocoa/40 dark:hover:border-cocoa/40 hover:bg-cocoa/5 dark:hover:bg-cocoa/5 transition-colors duration-150 group"
      >
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-cocoa"
            aria-hidden="true"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="text-sm font-medium">LinkedIn</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light group-hover:text-cocoa transition-colors" aria-hidden="true">
          <path d="M7 7h10v10M7 17 17 7"/>
        </svg>
      </a>

      <!-- Main website -->
      <a
        href="/"
        aria-label="Visit main website"
        class="flex items-center justify-between w-full px-5 py-4 rounded-xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 text-ink dark:text-cream hover:border-cocoa/40 dark:hover:border-cocoa/40 hover:bg-cocoa/5 dark:hover:bg-cocoa/5 transition-colors duration-150 group"
      >
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-cocoa"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
            <path d="M2 12h20"/>
          </svg>
          <span class="text-sm font-medium">Website</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light group-hover:text-cocoa transition-colors" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>

      <!-- Email -->
      <a
        href="mailto:hello@judithboehlert.com"
        aria-label="Send an email to hello@judithboehlert.com"
        class="flex items-center justify-between w-full px-5 py-4 rounded-xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 text-ink dark:text-cream hover:border-cocoa/40 dark:hover:border-cocoa/40 hover:bg-cocoa/5 dark:hover:bg-cocoa/5 transition-colors duration-150 group"
      >
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-cocoa"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span class="text-sm font-medium">Email: hello@judithboehlert.com</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light group-hover:text-cocoa transition-colors" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>

    </nav>
  </main>
</ConnectLayout>
