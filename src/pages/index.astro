---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import LowNoise from '../components/LowNoise.astro';
import Footer from '../components/Footer.astro';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Judith Böhlert',
  jobTitle: 'Frontend Tech Lead',
  url: 'https://judithboehlert.com',
  email: 'hello@judithboehlert.com',
  sameAs: [
    'https://www.linkedin.com/in/jboehlert/',
    'https://github.com/judicodes',
    'https://lownoiseclub.com',
  ],
};
---

<BaseLayout title="Judith Böhlert | Frontend Tech Lead">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(person)}
  />
  <Nav />
  <main id="main-content">
    <Hero />
    <LowNoise />
    <div class="border-t border-black/5 dark:border-white/5">
      <About />
    </div>
    <div class="border-t border-black/5 dark:border-white/5">
      <Services />
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Runs on first load and after every client-side navigation, since module
  // scripts execute only once per session under <ClientRouter />.
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  });
</script>
