---
import ThemeToggle from './ThemeToggle.astro';
---

<!-- Skip to main content for keyboard/screen reader users -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#8b6f47] focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
>
  Skip to main content
</a>

<header class="sticky top-0 z-40 backdrop-blur-sm bg-[#f5f4f1]/80 dark:bg-[#141412]/80 border-b border-black/5 dark:border-white/5">
  <nav
    class="max-w-4xl mx-auto px-6 h-14 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="font-serif text-lg font-bold tracking-tight text-[#1a1916] dark:text-[#e8e6e1] hover:text-[#8b6f47] dark:hover:text-[#8b6f47] transition-colors duration-150"
      aria-label="Home"
    >
      jb.
    </a>

    <div class="flex items-center gap-1">
      <a
        href="#hello"
        class="text-sm font-medium px-3 py-2 rounded-md text-[#6b6760] dark:text-[#9b9790] hover:text-[#1a1916] dark:hover:text-[#e8e6e1] hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-150"
      >
        About
      </a>
      <a
        href="#services"
        class="text-sm font-medium px-3 py-2 rounded-md text-[#6b6760] dark:text-[#9b9790] hover:text-[#1a1916] dark:hover:text-[#e8e6e1] hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-150"
      >
        Services
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
