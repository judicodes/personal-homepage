---
/*
  LowNoise section — intentionally hidden.

  To enable: remove the `style="display: none"` attribute from the <section> tag below,
  and update the content/links to point to your actual newsletter or low-noise channel.
*/
---

<!-- Low Noise section: currently hidden, remove display:none to enable -->
<section id="low-noise" style="display: none" aria-hidden="true">
  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-24">
    <div class="max-w-xl">
      <p class="text-sm font-medium tracking-widest uppercase text-[#8b6f47] mb-4">
        Low Noise
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1a1916] dark:text-[#e8e6e1] mb-4">
        Occasional signal, no spam
      </h2>
      <p class="text-[#6b6760] dark:text-[#9b9790] leading-relaxed mb-8">
        A slow newsletter. When something is worth writing about, you'll hear from me.
        No cadence, no filler, no sponsored content.
      </p>
      <a
        href="#"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#8b6f47] text-white text-sm font-medium hover:bg-[#7a5f38] transition-colors duration-150"
      >
        Subscribe
      </a>
    </div>
  </div>
</section>
