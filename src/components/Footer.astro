---
const year = new Date().getFullYear();
---

<footer class="border-t border-black/5 dark:border-white/5 py-8 mt-24">
  <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-light dark:text-stone-dark">
    <p>&copy; {year} Judith Boehlert. All rights reserved.</p>
    <nav aria-label="Footer navigation" class="flex items-center gap-4">
      <a
        href="/datenschutz"
        class="hover:text-ink dark:hover:text-cream transition-colors duration-150"
      >
        Datenschutz
      </a>
      <a
        href="/imprint"
        class="hover:text-ink dark:hover:text-cream transition-colors duration-150"
      >
        Impressum
      </a>
    </nav>
  </div>
</footer>
