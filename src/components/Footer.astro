---
const year = new Date().getFullYear();
---

<footer class="border-t border-black/5 dark:border-white/5 py-8 mt-24">
  <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[#6b6760] dark:text-[#9b9790]">
    <p>&copy; {year} J. All rights reserved.</p>
    <nav aria-label="Footer navigation">
      <a
        href="/imprint"
        class="hover:text-[#1a1916] dark:hover:text-[#e8e6e1] transition-colors duration-150"
      >
        Imprint
      </a>
    </nav>
  </div>
</footer>
