---
// ThemeToggle: markup only. The click handler lives in ThemeScript.astro,
// which delegates from `document` so it survives view-transition swaps.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="rounded-md p-2 text-fg-muted hover:text-fg hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-150"
>
  <span id="theme-toggle-inner" class="block transition-transform duration-300 motion-reduce:transition-none">
  <!-- Sun icon (shown in dark mode) -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden dark:block"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="block dark:hidden"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  </span>
</button>
