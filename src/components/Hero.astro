---
// Hero section: name, title, tagline, contact links
---

<section class="py-24 sm:py-32">
  <div class="max-w-4xl mx-auto px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-medium tracking-widest uppercase text-[#8b6f47] mb-4">
        Available for projects
      </p>

      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight text-[#1a1916] dark:text-[#e8e6e1] mb-6">
        Judith Böhlert
      </h1>

      <p class="text-xl sm:text-2xl font-serif italic text-[#6b6760] dark:text-[#9b9790] mb-6">
        Technology &amp; Product Consultant
      </p>

      <p class="text-base sm:text-lg leading-relaxed text-[#6b6760] dark:text-[#9b9790] mb-10 max-w-lg">
        I help companies navigate complex technology decisions, build great products,
        and grow high-performing engineering teams. Based in Berlin.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/jboehlert/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Connect on LinkedIn (opens in new tab)"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#1a1916] dark:bg-[#e8e6e1] text-[#f5f4f1] dark:text-[#1a1916] text-sm font-medium hover:bg-[#8b6f47] dark:hover:bg-[#8b6f47] dark:hover:text-white transition-colors duration-150"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>

        <!-- Email -->
        <a
          href="mailto:hello@judithboehlert.com"
          aria-label="Send an email"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-black/15 dark:border-white/15 text-[#1a1916] dark:text-[#e8e6e1] text-sm font-medium hover:border-[#8b6f47] hover:text-[#8b6f47] dark:hover:border-[#8b6f47] dark:hover:text-[#8b6f47] transition-colors duration-150"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          hello@judithboehlert.com
        </a>
      </div>
    </div>
  </div>
</section>
