---
// Hero section: name, title, tagline, contact links
---

<section class="py-24 sm:py-32">
  <div class="max-w-4xl mx-auto px-6">
    <div class="max-w-2xl">
      <h1 class="text-5xl sm:text-6xl lg:text-7xl leading-tight text-fg mb-6" style="font-family: 'Linea', serif;">
        Judith Boehlert
      </h1>

      <p class="text-xl sm:text-2xl font-serif italic text-fg-muted mb-6">
        Software Engineer &amp; Consultant
      </p>

      <p class="text-base sm:text-lg leading-relaxed text-fg-muted mb-10 max-w-lg">
        Trying to find calm in the chaos of tech.
      </p>

      <div class="flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-4">
          <!-- Low Noise Newsletter -->
          <a
            href="https://lownoiseclub.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Low Noise Newsletter (opens in new tab)"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-fg hover:text-accent transition-colors duration-150 group"
          >
            Low Noise Newsletter
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="opacity-50 group-hover:opacity-100 transition-opacity"
            >
              <path d="M7 7h10v10M7 17 17 7"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/jboehlert/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Connect on LinkedIn (opens in new tab)"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-fg hover:text-accent transition-colors duration-150 group"
          >
            LinkedIn
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="opacity-50 group-hover:opacity-100 transition-opacity"
            >
              <path d="M7 7h10v10M7 17 17 7"/>
            </svg>
          </a>
        </div>

        <!-- Email -->
        <a
          href="mailto:hello@judithboehlert.com"
          aria-label="Send an email"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-fg-muted hover:text-accent transition-colors duration-150"
        >
          hello@judithboehlert.com
        </a>
      </div>
    </div>
  </div>
</section>
