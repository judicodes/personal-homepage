---
// Services section: three tiles
interface Service {
  title: string;
  description: string;
  icon: string; // inline SVG path data
}

const services: Service[] = [
  {
    title: 'Software Engineering',
    description:
      'Hands-on technical leadership, architecture reviews, and engineering due diligence. ' +
      'I help teams make better technical decisions, reduce accidental complexity, and ship ' +
      'with confidence.',
    icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z',
  },
  {
    title: 'Consulting',
    description:
      'Strategic advisory for product and technology organisations. From defining roadmaps ' +
      'and selecting technology stacks to scaling engineering teams and improving delivery ' +
      'processes.',
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z',
  },
  {
    title: 'Public Speaking',
    description:
      'Conference talks, workshops, and panel discussions on topics spanning product ' +
      'development, engineering culture, and the intersection of technology and business ' +
      'strategy.',
    icon: 'M11 5.882V19.24a1.76 1.76 0 0 1-3.417.592l-2.147-6.15M18 13a3 3 0 1 0 0-6M5.436 13.683A4.001 4.001 0 0 1 7.028 6h1.157c.692 0 1.357.207 1.922.598l4.944 3.078A10.96 10.96 0 0 1 12 19.199V13H8.682Z',
  },
];
---

<section id="services" class="py-16 sm:py-24">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1a1916] dark:text-[#e8e6e1] mb-12">
      What I do
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {services.map((service) => (
        <article class="group rounded-2xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 p-6 hover:border-[#8b6f47]/30 dark:hover:border-[#8b6f47]/30 transition-colors duration-200">
          <div class="mb-4 w-10 h-10 rounded-lg bg-[#8b6f47]/10 dark:bg-[#8b6f47]/15 flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-[#8b6f47]"
              aria-hidden="true"
            >
              <path d={service.icon} />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-[#1a1916] dark:text-[#e8e6e1] mb-3">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-[#6b6760] dark:text-[#9b9790]">
            {service.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
