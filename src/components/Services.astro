---
// Services section: three tiles
interface Service {
  title: string;
  description: string;
  icon: string; // inline SVG path data
}

const services: Service[] = [
  {
    title: 'Software Engineering',
    description:
      'I build web applications from first prototype to production - mostly JavaScript and TypeScript, full-stack. I like the early stage: when the brief is still fuzzy, the architecture isn\'t set in stone, and moving fast matters. I\'m pragmatic and easy to bring into an existing team.',
    icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z',
  },
  {
    title: 'Consulting',
    description:
      'Sometimes you need an extra pair of hands. Sometimes you need someone to tell you honestly whether you\'re solving the right problem. I work with founders and technical leads on architecture, technology decisions, and the kind of questions that call for a considered outside perspective. No agenda, no jargon, no drama.',
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z',
  },
  {
    title: 'Public Speaking',
    description:
      'I speak at tech conferences and community events about the messy, human reality of building a tech career - the doubt, the pivots, and the things you figure out the hard way. The stuff people are quietly googling at 2am. Want me to speak at your event? Drop me a line.',
    icon: 'M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z M19 10v2a7 7 0 0 1-14 0v-2 M12 19v3 M8 22h8',
  },
];
---

<section id="services" class="py-16 sm:py-24 reveal">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-fg mb-12">
      What I do
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {services.map((service) => (
        <article class="group rounded-2xl border border-black/8 dark:border-white/8 bg-white/50 dark:bg-white/3 p-6 hover:border-accent/30 hover:-translate-y-1 hover:shadow-md dark:hover:shadow-black/30 transition-all duration-200 motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none">
          <div class="mb-4 w-10 h-10 rounded-lg bg-accent/10 dark:bg-accent/15 flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent"
              aria-hidden="true"
            >
              <path d={service.icon} />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-fg mb-3">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-fg-muted">
            {service.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
