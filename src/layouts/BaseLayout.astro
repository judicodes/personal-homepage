---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import ThemeScript from '../components/ThemeScript.astro';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Software Engineer & Consultant' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Self-hosted, no runtime request to Google. Three variable files in total:
      Inter (all weights), Playfair normal, Playfair italic. All three render
      above the fold here (nav, body copy, hero tagline), so all are preloaded.
      Filter by style, not weight: a variable file's preload entry carries only
      its first weight, so a {weight: 700} filter would never match.
    -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-playfair-display" preload />
    <ThemeScript />
    <ClientRouter />
    <Analytics />
  </head>
  <body class="bg-surface text-fg transition-colors duration-300">
    <slot />
  </body>
</html>
