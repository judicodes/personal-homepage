---
import '../styles/global.css';
import ThemeScript from '../components/ThemeScript.astro';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Connect', description = 'Get in touch' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted. This page renders no italic, so that file is declared but
         not preloaded. -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-playfair-display" preload={[{ style: 'normal' }]} />
    <ThemeScript />
    <ClientRouter />
  </head>
  <body class="bg-surface text-fg transition-colors duration-200 min-h-screen flex flex-col items-center justify-center">
    <slot />
  </body>
</html>
